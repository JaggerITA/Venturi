# Environment to build/run/test vv-app "headless" (Xvfb, no real
# GPU — software Vulkan via lavapipe, already inside mesa-vulkan-drivers)
# without touching the user's real graphical session. See container/README.md
# for how to use it. It does not contain the source: the repo must be mounted at
# runtime (bind mount), so it always reflects the current local state without
# having to rebuild the image on every change.
FROM fedora:44

# ffmpeg-devel (with libx264) lives on RPM Fusion free, not in the base Fedora
# repos — same reason explained in ../README.md.
RUN dnf install -y \
        https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-44.noarch.rpm && \
    dnf install -y \
        rust cargo \
        ffmpeg ffmpeg-devel \
        clang clang-devel \
        wayland-devel libxkbcommon-devel libxkbcommon-x11 libX11-devel \
        vulkan-loader-devel mesa-vulkan-drivers vulkan-tools \
        alsa-lib-devel \
        patchelf \
        git nasm \
        file \
        xorg-x11-server-Xvfb xdpyinfo \
        xdotool \
        ImageMagick \
        procps-ng \
    && dnf clean all

# ALSA without a real sound card: a null device keeps cpal from failing
# to open the stream at startup instead of simply playing
# nothing (vv-app does not need audio to be tested visually).
RUN printf 'pcm.!default {\n  type null\n}\nctl.!default {\n  type null\n}\n' \
        > /etc/asound.conf

# VK_ICD_FILENAMES pinned to lavapipe (software, aarch64 — the project
# targets Apple Silicon/Asahi anyway, see ARCHITECTURE.md): without it,
# the Vulkan loader also tries the hardware ICDs listed in
# /usr/share/vulkan/icd.d (none real in the container) before reaching
# the right one, filling the logs with harmless but noisy
# "vkEnumeratePhysicalDevices failed" errors.
ENV DISPLAY=:99 \
    XVFB_RESOLUTION=1280x800x24 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    CARGO_TARGET_DIR=/cargo-target \
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.aarch64.json

WORKDIR /workspace

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
